<div class="teamet">
<Image src={astrid} alt="Billede af Astrid"/>
<div>
<p><strong>Astrid Nørgaard</strong></p>
<p>Koordinator</p></div>
<div>
<p><strong>Mail:</strong></p>
<a href="mailto:astrid@raadgivningen-orfeus.dk">astrid@raadgivningen-orfeus.dk</a>
