---
import { Image } from "astro:assets";
import logo from "../assets/logo-1.svg";
---

<footer>
    <nav class="footernav">
        <div>
            <a href="/">
            <Image src={logo} alt="Illustration af en harpe, som er Orfeus's logo"/></a>
        
        <div class="social-media">
            <a href="https://www.facebook.com/profile.php?id=61589656891665"><i class="fa fa-facebook"></i></a>
            <a href="https://www.linkedin.com/company/r%C3%A5dgivningen-orfeus/"><i class="fa fa-linkedin"></i></a>
            <a href="https://www.instagram.com/raadgivningenorfeus/?hl=da"><i class="fa fa-instagram"></i></a>
        </div></div>
        <div>
            <p class="m"><strong>Vores sider</strong></p>
            <a href="https://www.raadgivningen-orfeus.dk/">Orfeus Hjemmeside</a>
            <a href="/">Kampagne Side</a>
            <a href="https://youtube.com/shorts/WkxPp_lTnKc?si=bDsqo5gzlnqUQb8v">Kampagne video</a>
            <a href="https://youtube.com/shorts/c2zQFNPl2Ok?si=GpCfF5vZeGuqVzRQ">Kampagne video 2</a>
        </div>
        <div>
            <p class="m"><strong>Kontakt</strong></p>
            <p>+45 70604657</p>
            <a href="mailto:kontakt@raadgivningen-orfeus.dk">kontakt@raadgivningen-orfeus.dk</a>
            <p>CVR: 46258657</p>
        </div>
    </nav>
</footer>

<style>
.fa {
    width: 30px;
    height: 30px;
  font-size: 24px;
  text-align: center;
  align-content: center;
  background-color: #255d2f;
  border-radius: 5px;
}
.fa:hover {
    background-color: var(--color-green700);
}
.social-media {
    display: flex;
    gap: 1rem;
    margin-top: 1rem;
}
    footer {
        background-color: var(--color-green800);
    }
    nav.footernav {
        display: grid;
        gap: 1.5rem;
        padding: 4rem 2rem;
        max-width: 1200px;
        margin-inline: auto;
        color: var(--color-white);
        img {
            max-width: 400px;
        }
        a {
            display: block;
            font-family: "Open Sans";
            color: var(--color-white);
            text-decoration: none;
        }
        a, p {
            padding-bottom: .25rem;
        }
        .m {
margin-bottom: .5rem;
        }

    }
@media (min-width:800px) {
    nav.footernav {
        grid-template-columns: 2fr 1fr 2fr;
        padding-top: 6rem;
        img {
            max-width: 300px;
        }
    }
}
</style>