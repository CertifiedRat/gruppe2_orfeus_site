---
const {headline, tekst} = Astro.props;
import { Image } from "astro:assets";
---

<article>
    <h2>{headline}</h2>
    <p>{tekst}</p>
</article>
<style>
    article {
        background-color: var(--color-green700);
        color: var(--color-white);
        text-align: center;
        img {
            max-width: 700px;
        }
    }
</style>