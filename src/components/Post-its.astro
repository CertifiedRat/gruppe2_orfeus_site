---
const {tekst, navn, baggrund} = Astro.props;
import { Image } from "astro:assets";
---
<article>
    <p>{tekst}</p>
    <p class="navn">{navn}</p>
    <Image src={baggrund} alt="Post it note baggrund" />
</article>

<style>
    article {
        display: grid;
        grid-template-rows: 1fr auto;
        max-width: 400px;
        margin-bottom: 1rem;
        height: min-content;
        place-self: center;
        /* background-image: url(../assets/postit-green2.png); */
        img {
            grid-row: 1 / 3;
            grid-column: 1 / 2;
            z-index: -1;
        }
        p {
            grid-row: 1 / 2;
            grid-column: 1 / 2;
        padding: 2rem 3rem 0;
        font-size: 24px;
        align-self: center;
        color: var(--color-white);
        }
        p.navn {
            grid-row: 2 / 3;
            grid-column: 1 / 2;
            place-self: end;
            padding: 0 6rem 4rem 2rem;
        }
    }
</style>